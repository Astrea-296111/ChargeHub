{
  "uid": "chargehub-operations",
  "title": "ChargeHub \u00b7 Real service and financial facts",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "ChargeHub",
    "simulation"
  ],
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chargehub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by(component,status) (rate(http_server_requests_seconds_count{uri!~\"/actuator/.*\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{component}} {{status}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP P50/P95/P99 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chargehub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5,sum by(le,component)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*\"}[5m])))",
          "refId": "A",
          "legendFormat": "P50 {{component}}"
        },
        {
          "expr": "histogram_quantile(0.95,sum by(le,component)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*\"}[5m])))",
          "refId": "B",
          "legendFormat": "P95 {{component}}"
        },
        {
          "expr": "histogram_quantile(0.99,sum by(le,component)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*\"}[5m])))",
          "refId": "C",
          "legendFormat": "P99 {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "DB connections pending",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chargehub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_pending",
          "refId": "A",
          "legendFormat": "{{component}} {{status}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
